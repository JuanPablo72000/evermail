# Copia este archivo como .env en la carpeta desde la que inicias Evermail.
# Completa los valores localmente; no pegues tokens ni contraseñas de correo.
# Google: cliente OAuth de tipo Desktop app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft: aplicación cliente público de escritorio. No requiere client secret.
MICROSOFT_CLIENT_ID=
# Registra exactamente http://127.0.0.1:53682/callback como redirect de cliente público.
MICROSOFT_REDIRECT_PORT=53682
