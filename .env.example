# Copia este archivo como .env en la carpeta desde la que inicias Evermail.
# Completa los valores localmente; no pegues tokens ni contraseñas de correo.
# Google: cliente OAuth de tipo Desktop app.
# Fotos de remitentes: habilita People API en el mismo proyecto de Google Cloud.
# En Google Auth Platform > Acceso a los datos, conserva los permisos existentes
# y añade estos dos permisos de solo lectura:
# https://www.googleapis.com/auth/contacts.readonly
# https://www.googleapis.com/auth/contacts.other.readonly
# Si la aplicación está en pruebas, incluye tu cuenta en Usuarios de prueba.
# Después acepta los permisos mediante «Volver a autorizar» en Evermail.
# No requiere variables nuevas ni cambiar las credenciales del .env existente.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft: aplicación cliente público de escritorio. No requiere client secret.
MICROSOFT_CLIENT_ID=
# Registra exactamente http://127.0.0.1:53682/callback como redirect de cliente público.
MICROSOFT_REDIRECT_PORT=53682

# Proxy de imágenes de Azure. Pega la clave solo en tu .env local.
IMAGE_PROXY_URL=https://evermail-images-juanp-hjeyfehagffreba3.mexicocentral-01.azurewebsites.net/api/image
IMAGE_PROXY_KEY=
