<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>
<?import com.juanpablo.evermail.ui.*?>
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="viewport" fx:controller="com.juanpablo.evermail.ui.ViewController" stylesheets="@../css/Common.css,@../css/Reader.css" styleClass="evermail-view,reader-view" fitToWidth="true" hbarPolicy="NEVER" prefWidth="1280" prefHeight="720" minWidth="0"><content><ResponsiveGrid fx:id="layout" mode="reader">
<fx:include fx:id="sidebar" source="Sidebar.fxml"/>
<VBox fx:id="reader" styleClass="reader-content" minWidth="0" prefHeight="700">
<FlowPane styleClass="reader-toolbar" minWidth="0">
<AnimatedButton fx:id="backButton" text="Volver" styleClass="button,outline"><graphic><MailIcon kind="back"/></graphic></AnimatedButton><AnimatedButton fx:id="previousButton" text="Anterior" styleClass="button,tool-button"><graphic><MailIcon kind="previous"/></graphic></AnimatedButton><AnimatedButton fx:id="nextButton" text="Siguiente" styleClass="button,tool-button"><graphic><MailIcon kind="next"/></graphic></AnimatedButton><AnimatedButton fx:id="replyButton" text="Responder" styleClass="button,tool-button"><graphic><MailIcon kind="reply"/></graphic></AnimatedButton><AnimatedButton fx:id="forwardButton" text="Reenviar" styleClass="button,tool-button"><graphic><MailIcon kind="forward"/></graphic></AnimatedButton><AnimatedButton fx:id="deleteButton" text="Eliminar" styleClass="button,tool-button"><graphic><MailIcon kind="delete"/></graphic></AnimatedButton><AnimatedButton fx:id="archiveButton" text="Archivar" styleClass="button,tool-button"><graphic><MailIcon kind="archive"/></graphic></AnimatedButton>
</FlowPane><Separator/>
<Label fx:id="readerSubject" text="Asunto: Test Correo" styleClass="title" wrapText="true"/>
<FlowPane styleClass="reader-meta" minWidth="0"><Label fx:id="senderAvatar" text="J" styleClass="avatar"/><VBox minWidth="0"><Label fx:id="senderName" text="Juan Pablo" styleClass="reader-sender" wrapText="true"/><Label fx:id="senderEmail" text="juanpablodev@gmail.com" styleClass="small,muted" wrapText="true"/></VBox><Label fx:id="sentAt" text="27 de Septiembre de 2026  01:23 pm" styleClass="small" wrapText="true"/></FlowPane>
<Label fx:id="recipients" text="Para: Mí &lt;tu.correo@gmail.com&gt;" styleClass="small" wrapText="true"/>
<FlowPane styleClass="reader-formats"><AnimatedButton fx:id="formattedButton" text="Ver Formato" styleClass="button,outline"/><AnimatedButton fx:id="textButton" text="Ver Texto" styleClass="button,outline"/></FlowPane>
<StackPane fx:id="bodyHost" styleClass="reader-body" minWidth="0" minHeight="320" VBox.vgrow="ALWAYS">
<TextArea fx:id="plainBody" editable="false" wrapText="true" styleClass="reader-text" text="" promptText="Contenido del correo" minWidth="0"/>
</StackPane></VBox></ResponsiveGrid></content></ScrollPane>
